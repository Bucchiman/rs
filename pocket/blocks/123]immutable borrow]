fn print_len(s: &String) {           // 参照を受け取る（所有しない）
    println!("{}", s.len());
}
fn main() {
    let s = String::from("hello");
    print_len(&s);                   // &s で不変借用
    println!("{}", s);               // 借用後も所有者は使える
}
