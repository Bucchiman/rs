struct Rectangle {
    width: u32,
    height: u32,
}
impl Rectangle {
    fn area(&self) -> u32 {
        self.width * self.height
    }
}

fn main() {
    let rect1 = Rectangle {width: 32, height: 50};
    println!("The are of the rectangle is {} square pixels.", rect1.are());
}
