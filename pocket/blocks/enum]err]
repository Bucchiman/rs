enum CreationError {
    Negative,
    Zero,
}

struct PositiveNonzeroInteger(u64);

impl PositiveNonzeroInteger {
    fn new(value: i64) -> Result<Self, CreationError> {
        if value > 0 {
            Ok(Self(value as u64))
        }
        else if value == 0 {
            Err(CreationError::Zero)
        }
        else {
            Err(CreationError::Negative)
        }
    }
}

